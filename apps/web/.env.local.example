# Soroban RPC endpoint (testnet by default)
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Escrow contract ID (deployed on Stellar)
NEXT_PUBLIC_ESCROW_CONTRACT_ID=PLACEHOLDER_ESCROW_CONTRACT_ID

# USDC token contract ID (on Stellar)
NEXT_PUBLIC_USDC_TOKEN_CONTRACT_ID=PLACEHOLDER_USDC_CONTRACT_ID
